{
  "name": "export-codebase",
  "version": "3.0.0",
  "description": "Aggregates project files into a single text file, respecting .gitignore.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "export-codebase": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "fulltest": "bun run build && bun run start",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "cli",
    "tool",
    "context",
    "code-concatenator",
    "llm"
  ],
  "author": "Burakhanunver <burakhanunver@gmail.com>",
  "license": "GPL-3.0-only",
  "dependencies": {
    "chalk": "^5.6.2",
    "fast-glob": "^3.3.3",
    "ignore": "^5.3.2",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
